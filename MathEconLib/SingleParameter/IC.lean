module

public import MathEconLib.SingleParameter.Basic
public import MathEconLib.ForMathlib.SupportingSlopes
import Mathlib.Tactic.Linarith

/-!
# Incentive Compatibility for Single-Parameter Problems

This file defines two equivalent report-based incentive conditions for a
`SingleParameterProblem` and a strengthening that considers every feasible action.

The two report-based presentations are equivalent:

1. `HasEnvelopeIC`: a comparison between the utilities and allocations of two
   types;
2. `HasTypeDeviationIC`: each type prefers its own strategy action to the
   action assigned to any other type;
3. `HasUniversalIC`: each type prefers its own strategy action to every
   feasible action.

The corresponding implication chain is

`HasUniversalIC → HasTypeDeviationIC ↔ HasEnvelopeIC`.

Only the forward direction of the equivalence is an instance, to avoid cycles
in typeclass search. Envelope IC is the supporting-slope condition on `U` and `q`.

This file also defines individual rationality. Participation is kept separate
from incentive compatibility: IC compares available actions, while individual
rationality requires the resulting utility to be nonnegative.
-/

namespace MathEconLib

@[expose] public section

open Set

universe u

namespace SingleParameterProblem

variable {Action : Type u} (P : SingleParameterProblem Action)

/-! ## Incentive compatibility -/

/-- **Envelope incentive compatibility** compares two types `v` and `v'`.

The inequality says that the utility difference between the types is at least
the type difference multiplied by the allocation assigned to `v'`.

This is the action-free presentation of type-deviation IC for quasilinear utility. -/
class HasEnvelopeIC (P : SingleParameterProblem Action) : Prop where
  envelopeIC : SupportingSlopesOn P.U P.q P.typeInterval

/-- **Type-deviation incentive compatibility** says that type `v` weakly
prefers its own strategy action to the strategy action assigned to any other
type `v'`. -/
class HasTypeDeviationIC (P : SingleParameterProblem Action) : Prop where
  typeDeviationIC : ∀ v ∈ P.typeInterval, ∀ v' ∈ P.typeInterval,
    P.payoff v (P.strategy v') ≤ P.payoff v (P.strategy v)

/-- **Universal incentive compatibility** says that type `v` weakly prefers
its own strategy action to every action in the feasible set `S`.

The `outParam` annotation allows typeclass search to infer `S` from an
available `HasUniversalIC` instance. -/
class HasUniversalIC
    (P : SingleParameterProblem Action) (S : outParam (Set Action)) : Prop where
  /-- The strategy chooses a feasible action for every type in the interval. -/
  strategyInS : ∀ v ∈ P.typeInterval, P.strategy v ∈ S
  /-- No feasible action gives a type more utility than its strategy action. -/
  universalIC : ∀ v ∈ P.typeInterval, ∀ a ∈ S,
    P.payoff v a ≤ P.payoff v (P.strategy v)

/-! ## The IC implication chain -/

/-- Type-deviation IC implies envelope IC. -/
instance instHasEnvelopeICOfHasTypeDeviationIC
    {P : SingleParameterProblem Action} [hIC : HasTypeDeviationIC P] :
    HasEnvelopeIC P where
  envelopeIC v hv v' hv' := by
    have h := hIC.typeDeviationIC v hv v' hv'
    simp only [payoff, q, U] at h ⊢
    linarith

/-- The supporting-slope presentation also implies report-deviation IC.
This direction is explicit so typeclass search has no implication cycle. -/
theorem hasTypeDeviationIC_of_hasEnvelopeIC [hIC : HasEnvelopeIC P] :
    HasTypeDeviationIC P where
  typeDeviationIC v hv v' hv' := by
    have h := hIC.envelopeIC v hv v' hv'
    simp only [payoff, q, U] at h ⊢
    linarith

/-- For quasilinear utility, envelope and report-deviation IC are equivalent. -/
theorem hasEnvelopeIC_iff_hasTypeDeviationIC : HasEnvelopeIC P ↔ HasTypeDeviationIC P :=
  ⟨fun h => @hasTypeDeviationIC_of_hasEnvelopeIC Action P h,
    fun h => @instHasEnvelopeICOfHasTypeDeviationIC Action P h⟩

/-- Universal IC implies type-deviation IC because the strategy action of any
other type is one of the feasible actions. -/
instance instHasTypeDeviationICOfHasUniversalIC
    {P : SingleParameterProblem Action} {S : Set Action}
    [hIC : HasUniversalIC P S] :
    HasTypeDeviationIC P where
  typeDeviationIC v hv v' hv' :=
    hIC.universalIC v hv (P.strategy v') (hIC.strategyInS v' hv')

/-! ## Incentive compatibility and reduced forms

Envelope IC and type-deviation IC depend only on behavior generated by the
strategy, so both pass between a problem and its canonical reduced form.
Forward transfers are instances, allowing reduced problems to use the generic
envelope and payment APIs directly. Reverse transfers are explicit theorems to
avoid typeclass-search cycles.

Universal IC additionally compares with arbitrary feasible actions. Because
`reduce` can forget actions outside the image of the original strategy, no
unqualified universal-IC equivalence is asserted here. -/

/-- Envelope IC for a problem supplies envelope IC for its reduced form. -/
instance instHasEnvelopeICReduce
    {P : SingleParameterProblem Action} [hIC : HasEnvelopeIC P] :
    HasEnvelopeIC P.reduce where
  envelopeIC v hv v' hv' :=
    hIC.envelopeIC v hv v' hv'

/-- Envelope IC for the reduced form supplies envelope IC for the original
problem. This is an explicit theorem rather than an instance to avoid a
typeclass-search cycle. -/
theorem hasEnvelopeIC_of_reduce
    {P : SingleParameterProblem Action} (hIC : HasEnvelopeIC P.reduce) :
    HasEnvelopeIC P where
  envelopeIC v hv v' hv' :=
    hIC.envelopeIC v hv v' hv'

/-- Type-deviation IC for a problem supplies type-deviation IC for its reduced
form. -/
instance instHasTypeDeviationICReduce
    {P : SingleParameterProblem Action} [hIC : HasTypeDeviationIC P] :
    HasTypeDeviationIC P.reduce where
  typeDeviationIC v hv v' hv' :=
    hIC.typeDeviationIC v hv v' hv'

/-- Type-deviation IC for the reduced form supplies type-deviation IC for the
original problem. This is an explicit theorem rather than an instance to avoid
a typeclass-search cycle. -/
theorem hasTypeDeviationIC_of_reduce
    {P : SingleParameterProblem Action} (hIC : HasTypeDeviationIC P.reduce) :
    HasTypeDeviationIC P where
  typeDeviationIC v hv v' hv' :=
    hIC.typeDeviationIC v hv v' hv'

/-! ## Participation -/

/-- **Individual rationality** with the standard normalization that every
type has outside-option utility zero. Every type in the type interval must
receive nonnegative utility. -/
def IsIndividuallyRational : Prop :=
  ∀ v ∈ P.typeInterval, 0 ≤ P.U v

/-- The lowest type receives utility zero.

This is stronger than individual rationality for the lowest type: it says that
the participation constraint binds there, not merely that utility is
nonnegative. -/
def HasZeroLowestTypeUtility : Prop :=
  P.U P.lowestType = 0

end SingleParameterProblem

end

end MathEconLib
